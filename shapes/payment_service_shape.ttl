@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# PaymentService Shape
schema:PaymentServiceShape
    a sh:NodeShape ;
    sh:targetClass schema:PaymentService ;
    
    # Basic identity
    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:description "Service name" ;
    ] ;
    
    sh:property [
        sh:path schema:description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:description "Service description" ;
    ] ;
    
    # Service type
    sh:property [
        sh:path schema:serviceType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:description "Service type" ;
    ] ;
    
    # Provider
    sh:property [
        sh:path schema:provider ;
        sh:datatype xsd:string ;
        sh:description "Service provider" ;
    ] ;
    
    # Payment methods
    sh:property [
        sh:path schema:paymentMethod ;
        sh:datatype xsd:string ;
        sh:description "Payment methods accepted" ;
    ] ;
    
    # Area served
    sh:property [
        sh:path schema:areaServed ;
        sh:datatype xsd:string ;
        sh:description "Area served" ;
    ] ;
    
    # Fees
    sh:property [
        sh:path schema:feesAndCommissionsSpecification ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:description "Fees and commissions" ;
    ] ;
    
    # Contact
    sh:property [
        sh:path schema:url ;
        sh:datatype xsd:anyURI ;
        sh:description "Service URL" ;
    ] ;
    
    sh:property [
        sh:path schema:telephone ;
        sh:datatype xsd:string ;
        sh:description "Telephone" ;
    ] ;
    
    sh:property [
        sh:path schema:email ;
        sh:datatype xsd:string ;
        sh:description "Email" ;
    ] ;
    
    # Currency
    sh:property [
        sh:path schema:currency ;
        sh:datatype xsd:string ;
        sh:description "Currencies supported" ;
    ] .

