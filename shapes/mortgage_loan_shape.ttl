@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# MortgageLoan Shape (inherits from LoanOrCredit)
schema:MortgageLoanShape
    a sh:NodeShape ;
    sh:targetClass schema:MortgageLoan ;
    
    # Basic identity
    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:description "Mortgage name" ;
    ] ;
    
    sh:property [
        sh:path schema:description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:description "Mortgage description" ;
    ] ;
    
    # Financial
    sh:property [
        sh:path schema:amount ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:description "Loan amount" ;
    ] ;
    
    sh:property [
        sh:path schema:annualPercentageRate ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:description "Annual Percentage Rate" ;
    ] ;
    
    sh:property [
        sh:path schema:interestRate ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:description "Interest rate" ;
    ] ;
    
    sh:property [
        sh:path schema:loanTerm ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:description "Loan term" ;
    ] ;
    
    sh:property [
        sh:path schema:currency ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:description "Currency" ;
    ] ;
    
    sh:property [
        sh:path schema:downPayment ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:description "Down payment" ;
    ] ;
    
    sh:property [
        sh:path schema:monthlyPayment ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:description "Monthly payment" ;
    ] ;
    
    # Parties
    sh:property [
        sh:path schema:lender ;
        sh:datatype xsd:string ;
        sh:description "Lender" ;
    ] ;
    
    sh:property [
        sh:path schema:borrower ;
        sh:datatype xsd:string ;
        sh:description "Borrower" ;
    ] ;
    
    # Property
    sh:property [
        sh:path schema:propertyAddress ;
        sh:class schema:PostalAddress ;
        sh:description "Property address" ;
    ] ;
    
    # Date
    sh:property [
        sh:path schema:dateIssued ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:description "Date issued" ;
    ] ;
    
    # Type
    sh:property [
        sh:path schema:loanType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:description "Loan type" ;
    ] .

